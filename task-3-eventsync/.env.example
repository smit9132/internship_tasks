PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/eventsync
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Optional: comma-separated browser origins. Leave unset for same-origin hosting.
CORS_ORIGINS=
# Set to 1 only when the app is behind a trusted HTTPS reverse proxy.
TRUST_PROXY=0
